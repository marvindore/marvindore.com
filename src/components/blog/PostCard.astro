---
import { formatDate, readingTime } from "../../lib/format";
import { youtubeThumbnail } from "../../lib/youtube";
import Icon from "../ui/Icon.astro";
import type { Post } from "../../lib/posts";

interface Props {
    post: Post;
    /** Heading level for the title, so the page outline never skips a level. */
    headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const { title, description, pubDate, youtubeId } = post.data;
---

<a class="post" href={`/blog/${post.id}`}>
    <div class="thumb">
        {youtubeId ? (
            <>
                <img src={youtubeThumbnail(youtubeId)} alt="" loading="lazy" />
                <span class="badge"><Icon name="play" size={14} /> Video</span>
            </>
        ) : (
            <span class="placeholder"><Icon name="pen" size={32} /></span>
        )}
    </div>
    <div class="body">
        <p class="meta">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {post.body && <span> · {readingTime(post.body)}</span>}
        </p>
        <Heading class="title">{title}</Heading>
        <p>{description}</p>
    </div>
</a>

<style>
    .post {
        display: grid;
        border-radius: var(--radius-md);
        background: var(--surface-muted);
        border: 1px solid var(--border);
        overflow: hidden;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .post:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-card);
    }

    .thumb {
        position: relative;
        aspect-ratio: 16 / 9;
        background: var(--brand-gradient);
        display: grid;
        place-items: center;
        color: #fff;
    }

    img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .badge {
        position: absolute;
        left: 0.75rem;
        bottom: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        background: rgb(0 0 0 / 0.65);
        backdrop-filter: blur(6px);
    }

    .body {
        display: grid;
        gap: 0.3rem;
        padding: 1rem 1.1rem 1.2rem;
    }

    .meta {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .title {
        font-size: 1.1rem;
        line-height: 1.3;
    }

    .body > p:last-child {
        font-size: 0.92rem;
        color: var(--text-muted);
    }
</style>
