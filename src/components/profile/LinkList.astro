---
import LinkCard from "../ui/LinkCard.astro";
import type { LinkItem } from "../../types";

interface Props {
    links: LinkItem[];
}
const { links } = Astro.props;
---

<ul class="links">
    {links.map((link) => <li class:list={{ wide: link.featured }}><LinkCard {link} /></li>)}
</ul>

<style>
    .links {
        display: grid;
        gap: 0.75rem;
    }

    /* iPad and up: two columns, featured link spans both */
    @media (min-width: 48rem) {
        .links {
            grid-template-columns: 1fr 1fr;
        }
        .wide {
            grid-column: 1 / -1;
        }
    }
</style>
