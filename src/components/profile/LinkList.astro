---
import LinkCard from "../ui/LinkCard.astro";
import type { LinkItem } from "../../types";

interface Props {
    links: LinkItem[];
}
const { links } = Astro.props;
---

<ul class="links">
    {
        links.map((link, i) => (
            <li class:list={{ wide: link.featured }} style={`--i: ${i + 2}`}>
                <LinkCard {link} />
            </li>
        ))
    }
</ul>

<style>
    .links {
        display: grid;
        gap: 0.75rem;
    }

    /* Staggered entrance */
    li {
        animation: reveal 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        animation-delay: calc(var(--i, 0) * 70ms);
    }

    /* iPad and up: two columns, featured link spans both */
    @media (min-width: 48rem) {
        .links {
            grid-template-columns: 1fr 1fr;
        }
        .wide {
            grid-column: 1 / -1;
        }
    }
</style>
