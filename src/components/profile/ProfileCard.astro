---
import SocialIcons from "./SocialIcons.astro";
import type { Profile, SocialLink } from "../../types";

interface Props {
    profile: Profile;
    socials: SocialLink[];
}
const { profile, socials } = Astro.props;
---

<header class="profile">
    <div class="avatar">
        <img src={profile.avatar} alt={profile.avatarAlt} width="112" height="112" fetchpriority="high" />
    </div>
    <h1>{profile.name}</h1>
    <p class="title">{profile.title}</p>
    <p class="bio">{profile.bio}</p>
    <SocialIcons {socials} />
</header>

<style>
    .profile {
        display: grid;
        justify-items: center;
        gap: 0.6rem;
        text-align: center;
    }

    .avatar {
        position: absolute;
        top: -3.5rem;
        left: 50%;
        translate: -50% 0;
        width: 7rem;
        height: 7rem;
        border-radius: 50%;
        padding: 0.35rem;
        background: var(--surface);
        box-shadow: 0 8px 24px -8px rgb(10 10 60 / 0.5);
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 50%;
        background: #fff;
    }

    h1 {
        font-size: 1.85rem;
        line-height: 1.15;
        letter-spacing: -0.02em;
    }

    .title {
        font-weight: 600;
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .bio {
        max-width: 28rem;
        color: var(--text-muted);
        margin-bottom: 0.6rem;
    }

    @media (min-width: 64rem) {
        .profile {
            position: sticky;
            top: 2rem;
            align-self: start;
            padding: 5rem 1.5rem 2.25rem;
            background: var(--surface);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
        }

        .avatar {
            top: -3.5rem;
        }
    }
</style>
