---
import type { EducationEntry } from "../../types";

interface Props {
    entry: EducationEntry;
}
const { entry } = Astro.props;
---

<article class="edu">
    <div class="title-row">
        <h3>{entry.school}</h3>
        <p class="period">{entry.period}</p>
    </div>
    <p>{entry.degree}</p>
    <p class="muted">Specialization: {entry.focus}</p>
</article>

<style>
    .edu {
        padding: 1rem 1.1rem;
        border-radius: var(--radius-md);
        background: var(--surface-muted);
        border: 1px solid var(--border);
    }

    .title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.1rem 1rem;
    }

    h3 {
        font-size: 1.05rem;
    }

    .period {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--link);
        white-space: nowrap;
    }

    .muted {
        font-size: 0.9rem;
        color: var(--text-muted);
    }
</style>
