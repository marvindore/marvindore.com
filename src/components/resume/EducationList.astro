---
import EducationEntry from "./EducationEntry.astro";
import type { EducationEntry as Entry } from "../../types";

interface Props {
    items: Entry[];
}
const { items } = Astro.props;
---

<div class="list">
    {items.map((entry) => <EducationEntry {entry} />)}
</div>

<style>
    .list {
        display: grid;
        gap: 0.75rem;
    }
</style>
