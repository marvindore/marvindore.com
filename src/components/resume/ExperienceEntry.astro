---
import type { ResumeEntry } from "../../types";

interface Props {
    entry: ResumeEntry;
}
const { entry } = Astro.props;
---

<article class="entry">
    <header>
        <h3>{entry.role}</h3>
        <p class="meta">{entry.company} · {entry.location}</p>
        <p class="period">{entry.period}</p>
    </header>
    {entry.summary && <p class="summary">{entry.summary}</p>}
    <ul>
        {entry.highlights.map((h) => <li>{h}</li>)}
    </ul>
</article>

<style>
    .entry {
        display: grid;
        gap: 0.75rem;
        padding-left: 1rem;
        border-left: 2px solid var(--border);
    }

    h3 {
        font-size: 1.1rem;
        line-height: 1.3;
    }

    .meta {
        color: var(--text-muted);
        font-size: 0.92rem;
    }

    .period {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--brand-from);
    }

    .summary {
        font-size: 0.92rem;
        color: var(--text-muted);
    }

    ul {
        display: grid;
        gap: 0.6rem;
        list-style: disc;
        padding-left: 1.1rem;
        font-size: 0.93rem;
    }
</style>
