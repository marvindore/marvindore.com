---
import type { ExperienceEntry } from "../../types";

interface Props {
    entry: ExperienceEntry;
}
const { entry } = Astro.props;
---

<article class="entry">
    <header>
        <div class="title-row">
            <h3>{entry.role}</h3>
            <p class="period">{entry.period}</p>
        </div>
        <p class="meta">{entry.company} · {entry.location}</p>
    </header>
    {entry.summary && <p class="summary">{entry.summary}</p>}
    <ul>
        {
            entry.highlights.map((h) => (
                <li>
                    {h.lead && <strong>{h.lead}. </strong>}
                    {h.text}
                </li>
            ))
        }
    </ul>
</article>

<style>
    .entry {
        display: grid;
        gap: 0.75rem;
        padding-left: 1rem;
        border-left: 2px solid var(--border);
    }

    .title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.1rem 1rem;
    }

    h3 {
        font-size: 1.15rem;
        line-height: 1.3;
    }

    .period {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--link);
        white-space: nowrap;
    }

    .meta {
        color: var(--text-muted);
        font-size: 0.92rem;
    }

    .summary {
        font-size: 0.92rem;
        color: var(--text-muted);
    }

    ul {
        display: grid;
        gap: 0.65rem;
        list-style: disc;
        padding-left: 1.1rem;
        font-size: 0.95rem;
        line-height: 1.55;
    }
</style>
