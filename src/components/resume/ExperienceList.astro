---
import ExperienceEntry from "./ExperienceEntry.astro";
import type { ExperienceEntry as Entry } from "../../types";

interface Props {
    items: Entry[];
}
const { items } = Astro.props;
---

<div class="list">
    {items.map((entry) => <ExperienceEntry {entry} />)}
</div>

<style>
    .list {
        display: grid;
        gap: 1.75rem;
    }
</style>
