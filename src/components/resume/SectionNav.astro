---
interface Props {
    sections: { id: string; title: string }[];
}
const { sections } = Astro.props;
---

<nav class="nav no-print" aria-label="Resume sections">
    <ul>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
    </ul>
</nav>

<style>
    .nav {
        position: sticky;
        top: env(safe-area-inset-top, 0px);
        z-index: 5;
        margin-inline: calc(var(--gutter) * -1);
        /* The pill boxes line up with the content edge, like the contact chips and buttons */
        padding: 0.6rem var(--gutter);
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
    }

    ul {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        scrollbar-width: none;
    }

    ul::-webkit-scrollbar {
        display: none;
    }

    a {
        display: inline-flex;
        align-items: center;
        flex: none;
        min-height: 2.5rem;
        padding-inline: 1rem;
        border-radius: 999px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-muted);
        border: 1px solid transparent;
        transition: color 0.15s ease, background 0.15s ease;
    }

    a:hover {
        color: var(--text);
    }

    a[aria-current="true"] {
        color: var(--on-brand);
        background: var(--brand-gradient);
    }

    @media (min-width: 48rem) {
        .nav {
            margin-inline: -3rem;
            padding-inline: 3rem;
        }
    }
</style>

<script>
    import { watchSections } from "../../lib/scrollSpy";

    watchSections(document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Resume sections"] a'));
</script>
