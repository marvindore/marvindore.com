---
import Icon from "./Icon.astro";

interface Props {
    href?: string;
    label?: string;
}
const { href = "/", label = "Home" } = Astro.props;
---

<a class="back" {href}>
    <Icon name="arrow-left" size={18} />
    <span>{label}</span>
</a>

<style>
    .back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.75rem;
        padding-inline: 0.9rem 1.1rem;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text);
        background: var(--surface-muted);
        border: 1px solid var(--border);
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .back:hover {
        transform: translateX(-2px);
        background: var(--surface);
    }
</style>
