---
import Icon from "./Icon.astro";
import { isExternal } from "../../lib/links";
import type { LinkItem } from "../../types";

interface Props {
    link: LinkItem;
}
const { link } = Astro.props;
const external = isExternal(link.href);
---

<a
    class:list={["card", { featured: link.featured }]}
    href={link.href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    data-track={`link:${link.title}`}
>
    <Icon class="icon" name={link.icon} size={22} />
    <span class="title">{link.title}</span>
    {link.badge && <span class="badge">{link.badge}</span>}
</a>

<style>
    .card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 3.5rem;
        padding: 0.75rem 3.25rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        background: var(--surface-muted);
        border: 1px solid var(--border);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    /* Icon sits at the left edge while the label stays centered, as in a classic link-in-bio button */
    .card :global(.icon) {
        position: absolute;
        left: 1.1rem;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-card);
        border-color: var(--brand-from);
    }

    .card:active {
        transform: scale(0.985);
    }

    .badge {
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--on-brand);
        background: var(--brand-gradient);
    }

    .card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%);
        translate: -100% 0;
        transition: translate 0.6s ease;
        pointer-events: none;
    }

    .card:hover::after {
        translate: 100% 0;
    }

    .featured {
        color: var(--on-brand);
        background: var(--brand-gradient);
        border-color: transparent;
        box-shadow: var(--shadow-lift);
    }

    .featured:hover {
        border-color: transparent;
    }

    .featured .badge {
        background: rgb(255 255 255 / 0.25);
    }
</style>
