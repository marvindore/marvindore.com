---
import Icon from "./Icon.astro";
import { isExternal } from "../../lib/links";
import type { LinkItem } from "../../types";

interface Props {
    link: LinkItem;
}
const { link } = Astro.props;
const external = isExternal(link.href);
---

<a
    class:list={["card", { featured: link.featured }]}
    href={link.href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
>
    <span class="icon"><Icon name={link.icon} size={22} /></span>
    <span class="text">
        <span class="title">{link.title}</span>
        {link.description && <span class="desc">{link.description}</span>}
    </span>
    <Icon class="arrow" name={external ? "arrow-up-right" : "chevron-right"} size={20} />
</a>

<style>
    .card {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-height: 4.25rem;
        padding: 0.8rem 1.1rem 0.8rem 0.85rem;
        border-radius: var(--radius-md);
        background: var(--surface-muted);
        border: 1px solid var(--border);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-card);
        border-color: var(--brand-from);
    }

    .card:active {
        transform: scale(0.985);
    }

    .icon {
        display: grid;
        place-items: center;
        flex: none;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.85rem;
        background: var(--surface);
        border: 1px solid var(--border);
    }

    .text {
        display: grid;
        flex: 1;
        min-width: 0;
    }

    .title {
        font-weight: 600;
        line-height: 1.3;
    }

    .desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.35;
    }

    .card :global(.arrow) {
        flex: none;
        color: var(--text-muted);
    }

    .featured {
        color: var(--on-brand);
        background: var(--brand-gradient);
        border-color: transparent;
        box-shadow: var(--shadow-lift);
    }

    .featured:hover {
        border-color: transparent;
    }

    .featured .icon {
        background: rgb(255 255 255 / 0.18);
        border-color: rgb(255 255 255 / 0.25);
    }

    .featured .desc,
    .featured :global(.arrow) {
        color: rgb(255 255 255 / 0.85);
    }
</style>
