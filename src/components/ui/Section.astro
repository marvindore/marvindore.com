---
interface Props {
    title: string;
    id?: string;
}
const { title, id } = Astro.props;
---

<section class="section" aria-labelledby={id}>
    <h2 {id}>{title}</h2>
    <slot />
</section>

<style>
    .section {
        display: grid;
        gap: 1rem;
    }

    h2 {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
    }
</style>
