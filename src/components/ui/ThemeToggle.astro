---
import Icon from "./Icon.astro";
---

<button class="toggle" type="button" aria-label="Switch between light and dark theme" data-theme-toggle>
    <Icon class="moon" name="moon" size={20} />
    <Icon class="sun" name="sun" size={20} />
</button>

<style>
    .toggle {
        position: absolute;
        z-index: 10;
        top: calc(env(safe-area-inset-top, 0px) + 0.75rem);
        right: 0.75rem;
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border: 1px solid rgb(255 255 255 / 0.25);
        border-radius: 50%;
        color: #fff;
        background: rgb(8 8 36 / 0.45);
        backdrop-filter: blur(8px);
        cursor: pointer;
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .toggle:hover {
        transform: scale(1.08);
        background: rgb(8 8 36 / 0.7);
    }

    /* Show the icon for the theme you would switch to */
    .toggle :global(.sun) {
        display: none;
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .toggle :global(.moon) {
            display: none;
        }
        :global(:root:not([data-theme="light"])) .toggle :global(.sun) {
            display: block;
        }
    }

    :global(:root[data-theme="dark"]) .toggle :global(.moon) {
        display: none;
    }

    :global(:root[data-theme="dark"]) .toggle :global(.sun) {
        display: block;
    }

    :global(:root[data-theme="light"]) .toggle :global(.moon) {
        display: block;
    }

    :global(:root[data-theme="light"]) .toggle :global(.sun) {
        display: none;
    }
</style>

<script>
    import { toggleTheme } from "../../lib/theme";

    document.querySelector("[data-theme-toggle]")?.addEventListener("click", toggleTheme);
</script>
