---
import Aurora from "../components/ui/Aurora.astro";
import BackLink from "../components/ui/BackLink.astro";
import Sheet from "../components/ui/Sheet.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
    title: string;
    heading?: string;
    description?: string;
    image?: string;
    backHref?: string;
    backLabel?: string;
}
const { heading, backHref, backLabel, ...meta } = Astro.props;
---

<BaseLayout {...meta}>
    <div class="stage">
        <Aurora size="short" />
        <Sheet class="page-sheet">
            <div class="top">
                <BackLink href={backHref} label={backLabel} />
            </div>
            <h1>{heading ?? meta.title}</h1>
            <slot name="lead" />
            <div class="body"><slot /></div>
        </Sheet>
    </div>
</BaseLayout>

<style>
    .stage {
        position: relative;
        padding-top: 6rem;
        overflow: clip;
    }

    @media (min-width: 48rem) {
        .stage {
            padding: 4.5rem var(--gutter) 3rem;
        }
    }

    .stage :global(.sheet.page-sheet) {
        padding-top: 2.5rem;
    }

    .top {
        margin-bottom: 1.25rem;
    }

    h1 {
        font-size: clamp(1.8rem, 5vw, 2.4rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
    }

    .body {
        display: grid;
        gap: 2rem;
        margin-top: 1.5rem;
    }
</style>
