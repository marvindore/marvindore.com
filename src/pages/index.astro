---
import PostList from "../components/blog/PostList.astro";
import HomeShell from "../components/home/HomeShell.astro";
import LinkList from "../components/profile/LinkList.astro";
import ProfileCard from "../components/profile/ProfileCard.astro";
import Section from "../components/ui/Section.astro";
import { links } from "../data/links";
import { profile, socials } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withFreshness } from "../lib/links";
import { getLatestPosts } from "../lib/posts";

const latestPosts = await getLatestPosts(2);
const freshLinks = withFreshness(links, latestPosts[0]?.data.pubDate);
---

<BaseLayout description={profile.valueProp}>
    <HomeShell>
        <ProfileCard slot="profile" {profile} {socials} tagline={profile.valueProp} />
        <Section title="Links" id="links">
            <LinkList links={freshLinks} />
        </Section>
        {
            latestPosts.length > 0 && (
                <Section title="Latest from the blog" id="latest">
                    <PostList posts={latestPosts} />
                    <a class="all" href="/blog">View all posts →</a>
                </Section>
            )
        }
    </HomeShell>
</BaseLayout>

<style>
    .all {
        justify-self: center;
        font-weight: 600;
        color: var(--link);
        padding: 0.5rem 1rem;
    }
</style>
