---
import ContactLinks from "../components/resume/ContactLinks.astro";
import SectionNav from "../components/resume/SectionNav.astro";
import { resumeSections } from "../components/resume/sections";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import { profile, socials } from "../data/profile";
import { education, experience, meta, skills } from "../data/resume";
import PageLayout from "../layouts/PageLayout.astro";
import { fileLabel } from "../lib/fileInfo";
import { buildPersonSchema, toJsonLd } from "../lib/resume/schema";

const contact = meta.contactIcons
    .map((icon) => socials.find((s) => s.icon === icon))
    .filter((s): s is NonNullable<typeof s> => Boolean(s));

const siteUrl = (Astro.site ?? Astro.url.origin).toString();
const personJsonLd = toJsonLd(buildPersonSchema({ siteUrl, profile, socials, meta, experience, education, skills }));
---

<PageLayout
    title="Resume"
    heading={profile.name}
    description={`${profile.name}: ${meta.headline}. View the resume online or download the PDF.`}
>
    <script slot="head" type="application/ld+json" set:html={personJsonLd} />

    <div slot="lead" class="lead">
        <p class="headline">{meta.headline}</p>
        <ContactLinks links={contact} />
        <div class="download no-print">
            <Button href={meta.pdfHref} icon="download" download={meta.pdfFilename}>Download PDF</Button>
            <p class="file">{fileLabel(meta.pdfHref, "PDF")} · Updated {meta.updated}</p>
        </div>
    </div>

    <SectionNav sections={resumeSections} />

    {
        resumeSections.map(({ id, title, component: SectionContent, props }) => (
            <Section {id} {title}>
                <SectionContent {...props} />
            </Section>
        ))
    }
</PageLayout>

<style>
    .lead {
        display: grid;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .headline {
        font-weight: 600;
        color: var(--text-muted);
    }

    .download {
        display: grid;
        gap: 0.4rem;
        justify-items: start;
    }

    .download :global(.btn) {
        width: 100%;
    }

    .file {
        width: 100%;
        text-align: center;
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    @media (min-width: 48rem) {
        .download {
            grid-auto-flow: column;
            justify-content: start;
            align-items: center;
            gap: 1rem;
        }

        .download :global(.btn) {
            width: auto;
        }

        .file {
            width: auto;
            text-align: left;
        }
    }
</style>
